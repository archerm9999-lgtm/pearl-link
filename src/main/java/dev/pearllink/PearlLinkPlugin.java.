package dev.pearllink;

import org.bukkit.Bukkit;
import org.bukkit.Location;
import org.bukkit.Material;
import org.bukkit.NamespacedKey;
import org.bukkit.World;
import org.bukkit.command.Command;
import org.bukkit.command.CommandSender;
import org.bukkit.entity.EnderPearl;
import org.bukkit.entity.Entity;
import org.bukkit.entity.Player;
import org.bukkit.event.EventHandler;
import org.bukkit.event.EventPriority;
import org.bukkit.event.Listener;
import org.bukkit.event.block.Action;
import org.bukkit.event.player.PlayerInteractEntityEvent;
import org.bukkit.event.player.PlayerInteractEvent;
import org.bukkit.inventory.EquipmentSlot;
import org.bukkit.inventory.ItemStack;
import org.bukkit.inventory.meta.ItemMeta;
import org.bukkit.persistence.PersistentDataType;
import org.bukkit.plugin.java.JavaPlugin;
import org.bukkit.projectiles.ProjectileSource;

import java.util.List;
import java.util.UUID;

public final class PearlLinkPlugin extends JavaPlugin implements Listener {
    private NamespacedKey pearlKey;
    private NamespacedKey worldKey;
    private NamespacedKey linkerKey;
    private NamespacedKey orbitalKey;
    private NamespacedKey targetKey;

    @Override
    public void onEnable() {
        pearlKey = new NamespacedKey(this, "pearl_uuid");
        worldKey = new NamespacedKey(this, "pearl_world");
        linkerKey = new NamespacedKey(this, "linker_uuid");
        orbitalKey = new NamespacedKey(this, "orbital_rod");
        targetKey = new NamespacedKey(this, "orbital_target");
        Bukkit.getPluginManager().registerEvents(this, this);
        getLogger().info("PearlLink 1.1.0 enabled.");
    }

    // Sneak + right-click the exact pearl entity with a normal fishing rod.
    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = false)
    public void onPearlPair(PlayerInteractEntityEvent event) {
        Player linker = event.getPlayer();
        if (event.getHand() != EquipmentSlot.HAND || !linker.isSneaking()) return;

        ItemStack rod = linker.getInventory().getItemInMainHand();
        if (rod.getType() != Material.FISHING_ROD || isOrbitalRod(rod)) return;
        if (!(event.getRightClicked() instanceof EnderPearl pearl)) return;

        ProjectileSource shooter = pearl.getShooter();
        if (!(shooter instanceof Player)) {
            linker.sendMessage("§cPearlLink: this pearl must have been thrown by a player.");
            event.setCancelled(true);
            return;
        }

        ItemMeta meta = rod.getItemMeta();
        if (meta == null) return;
        var pdc = meta.getPersistentDataContainer();
        pdc.set(pearlKey, PersistentDataType.STRING, pearl.getUniqueId().toString());
        pdc.set(worldKey, PersistentDataType.STRING, pearl.getWorld().getUID().toString());
        pdc.set(linkerKey, PersistentDataType.STRING, linker.getUniqueId().toString());
        rod.setItemMeta(meta);

        // Persistent registry allows the OP Orbital Rod to look up this player's pearl.
        getConfig().set("links." + linker.getUniqueId() + ".pearl", pearl.getUniqueId().toString());
        getConfig().set("links." + linker.getUniqueId() + ".world", pearl.getWorld().getUID().toString());
        saveConfig();

        linker.sendMessage("§aPearlLink: paired! Anyone can pull this rod, but only you will be teleported.");
        event.setCancelled(true);
    }

    // Anyone can activate a normal linked rod; only its linker is teleported.
    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = false)
    public void onRodUse(PlayerInteractEvent event) {
        if (event.getHand() != EquipmentSlot.HAND) return;
        Action action = event.getAction();
        if (action != Action.RIGHT_CLICK_AIR && action != Action.RIGHT_CLICK_BLOCK) return;

        Player activator = event.getPlayer();
        ItemStack rod = activator.getInventory().getItemInMainHand();
        if (rod.getType() != Material.FISHING_ROD) return;

        if (isOrbitalRod(rod)) {
            event.setCancelled(true);
            activateOrbitalRod(activator, rod);
            return;
        }
        if (!hasNormalLink(rod)) return;

        event.setCancelled(true);
        var pdc = rod.getItemMeta().getPersistentDataContainer();
        UUID pearlId = parseUuid(pdc.get(pearlKey, PersistentDataType.STRING));
        UUID worldId = parseUuid(pdc.get(worldKey, PersistentDataType.STRING));
        UUID linkerId = parseUuid(pdc.get(linkerKey, PersistentDataType.STRING));

        World world = worldId == null ? null : Bukkit.getWorld(worldId);
        Entity found = world == null || pearlId == null ? null : world.getEntity(pearlId);
        Player linker = linkerId == null ? null : Bukkit.getPlayer(linkerId);

        if (!(found instanceof EnderPearl pearl) || !pearl.isValid()) {
            activator.sendMessage("§cPearlLink: linked pearl is not loaded or no longer exists.");
            return;
        }
        if (linker == null || !linker.isOnline() || !linker.getWorld().equals(world)) {
            activator.sendMessage("§cPearlLink: the player who linked this rod must be online in the pearl's world.");
            return;
        }

        Location destination = pearl.getLocation().clone();
        pearl.remove();
        linker.teleport(destination);
        clearNormalLink(rod);
        removeRegisteredLink(linkerId);
        activator.sendMessage("§aPearlLink: activated! " + linker.getName() + " was teleported.");
    }

    // OPs select a player by sneaking and right-clicking them with the Orbital Rod.
    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = false)
    public void onOrbitalTargetSelect(PlayerInteractEntityEvent event) {
        Player operator = event.getPlayer();
        if (event.getHand() != EquipmentSlot.HAND || !operator.isSneaking()) return;
        ItemStack rod = operator.getInventory().getItemInMainHand();
        if (!isOrbitalRod(rod)) return;

        if (!operator.isOp()) {
            operator.sendMessage("§cOnly operators can use the Orbital Rod.");
            event.setCancelled(true);
            return;
        }
        if (!(event.getRightClicked() instanceof Player target)) return;

        ItemMeta meta = rod.getItemMeta();
        meta.getPersistentDataContainer().set(targetKey, PersistentDataType.STRING,
                target.getUniqueId().toString());
        rod.setItemMeta(meta);
        operator.sendMessage("§dOrbital Rod target selected: " + target.getName());
        event.setCancelled(true);
    }

    // Pull the selected player's pearl to the operator, then teleport the linker to the operator.
    private void activateOrbitalRod(Player operator, ItemStack rod) {
        if (!operator.isOp()) {
            operator.sendMessage("§cOnly operators can use the Orbital Rod.");
            return;
        }

        String targetText = rod.getItemMeta().getPersistentDataContainer()
                .get(targetKey, PersistentDataType.STRING);
        UUID targetId = parseUuid(targetText);
        if (targetId == null) {
            operator.sendMessage("§cOrbital Rod: sneak + right-click a player to select a target first.");
            return;
        }

        String pearlText = getConfig().getString("links." + targetId + ".pearl");
        String worldText = getConfig().getString("links." + targetId + ".world");
        UUID pearlId = parseUuid(pearlText);
        UUID worldId = parseUuid(worldText);
        World world = worldId == null ? null : Bukkit.getWorld(worldId);
        Entity found = world == null || pearlId == null ? null : world.getEntity(pearlId);
        Player linker = Bukkit.getPlayer(targetId);

        if (!(found instanceof EnderPearl pearl) || !pearl.isValid()) {
            operator.sendMessage("§cOrbital Rod: that player's pearl is not loaded or no longer exists.");
            return;
        }
        if (linker == null || !linker.isOnline()) {
            operator.sendMessage("§cOrbital Rod: the selected player must be online.");
            return;
        }

        Location impact = operator.getLocation().clone();
        pearl.remove();
        linker.teleport(impact);
        removeRegisteredLink(targetId);
        operator.sendMessage("§dOrbital cannon fired! " + linker.getName() + " was pulled to you.");
    }

    private void removeRegisteredLink(UUID playerId) {
        getConfig().set("links." + playerId, null);
        saveConfig();
    }

    private boolean isOrbitalRod(ItemStack item) {
        return item != null && item.getType() == Material.FISHING_ROD && item.hasItemMeta()
                && item.getItemMeta().getPersistentDataContainer()
                .has(orbitalKey, PersistentDataType.BYTE);
    }

    private boolean hasNormalLink(ItemStack item) {
        if (!item.hasItemMeta()) return false;
        var pdc = item.getItemMeta().getPersistentDataContainer();
        return pdc.has(pearlKey, PersistentDataType.STRING)
                && pdc.has(worldKey, PersistentDataType.STRING)
                && pdc.has(linkerKey, PersistentDataType.STRING);
    }

    private UUID parseUuid(String value) {
        try {
            return value == null ? null : UUID.fromString(value);
        } catch (IllegalArgumentException ignored) {
            return null;
        }
    }

    private void clearNormalLink(ItemStack rod) {
        ItemMeta meta = rod.getItemMeta();
        if (meta == null) return;
        var pdc = meta.getPersistentDataContainer();
        pdc.remove(pearlKey);
        pdc.remove(worldKey);
        pdc.remove(linkerKey);
        rod.setItemMeta(meta);
    }

    @Override
    public boolean onCommand(CommandSender sender, Command command, String label, String[] args) {
        if (!command.getName().equalsIgnoreCase("pearlrod")) return false;
        if (!(sender instanceof Player player) || !player.isOp()) {
            sender.sendMessage("§cOnly an OP player can use this command.");
            return true;
        }
        if (args.length != 1 || !args[0].equalsIgnoreCase("give")) {
            player.sendMessage("§eUsage: /pearlrod give");
            return true;
        }

        ItemStack rod = new ItemStack(Material.FISHING_ROD);
        ItemMeta meta = rod.getItemMeta();
        meta.setDisplayName("§d§lOrbital Rod");
        meta.setLore(List.of(
                "§7Sneak + right-click a player to select them.",
                "§7Right-click to pull their linked pearl to you.",
                "§cOP only"
        ));
        meta.getPersistentDataContainer().set(orbitalKey, PersistentDataType.BYTE, (byte) 1);
        rod.setItemMeta(meta);
        player.getInventory().addItem(rod);
        player.sendMessage("§dOrbital Rod given. Sneak + right-click a player to target them.");
        return true;
    }
}
