name: Build PearlLink

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Build with Maven
        run: mvn -B package

      - uses: actions/upload-artifact@v4
        with:
          name: pearl-link
          path: target/pearl-link-1.0.0.jar
